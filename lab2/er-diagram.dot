digraph er {
  graph [rankdir=LR, splines=spline, nodesep=0.5, ranksep=1.4, fontname=Arial];
  node  [shape=plain, fontname=Arial, fontsize=11];
  edge  [dir=both, penwidth=1.3, arrowsize=0.8];
  artists [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2b6cb0"><TR><TD COLSPAN="3" BGCOLOR="#ebf4ff"><B>artists</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w"><FONT COLOR="#718096">PK</FONT></TD><TD ALIGN="LEFT">* <B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name_w"> </TD><TD ALIGN="LEFT">* full_name</TD><TD ALIGN="LEFT" PORT="full_name_e"><FONT COLOR="#718096">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stage_name_w"> </TD><TD ALIGN="LEFT">stage_name</TD><TD ALIGN="LEFT" PORT="stage_name_e"><FONT COLOR="#718096">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="birth_date_w"> </TD><TD ALIGN="LEFT">birth_date</TD><TD ALIGN="LEFT" PORT="birth_date_e"><FONT COLOR="#718096">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description_w"> </TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT" PORT="description_e"><FONT COLOR="#718096">text</FONT></TD></TR></TABLE>>];
  event_artists [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2b6cb0"><TR><TD COLSPAN="3" BGCOLOR="#ebf4ff"><B>event_artists</B></TD></TR><TR><TD ALIGN="LEFT" PORT="event_id_w"><FONT COLOR="#718096">PK, FK</FONT></TD><TD ALIGN="LEFT">* <B>event_id</B></TD><TD ALIGN="LEFT" PORT="event_id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="artist_id_w"><FONT COLOR="#718096">PK, FK</FONT></TD><TD ALIGN="LEFT">* <B>artist_id</B></TD><TD ALIGN="LEFT" PORT="artist_id_e"><FONT COLOR="#718096">integer</FONT></TD></TR></TABLE>>];
  event_organizers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2b6cb0"><TR><TD COLSPAN="3" BGCOLOR="#ebf4ff"><B>event_organizers</B></TD></TR><TR><TD ALIGN="LEFT" PORT="event_id_w"><FONT COLOR="#718096">PK, FK</FONT></TD><TD ALIGN="LEFT">* <B>event_id</B></TD><TD ALIGN="LEFT" PORT="event_id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="organizer_id_w"><FONT COLOR="#718096">PK, FK</FONT></TD><TD ALIGN="LEFT">* <B>organizer_id</B></TD><TD ALIGN="LEFT" PORT="organizer_id_e"><FONT COLOR="#718096">integer</FONT></TD></TR></TABLE>>];
  event_zones [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2b6cb0"><TR><TD COLSPAN="3" BGCOLOR="#ebf4ff"><B>event_zones</B></TD></TR><TR><TD ALIGN="LEFT" PORT="event_id_w"><FONT COLOR="#718096">PK, FK</FONT></TD><TD ALIGN="LEFT">* <B>event_id</B></TD><TD ALIGN="LEFT" PORT="event_id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="zone_id_w"><FONT COLOR="#718096">PK, FK</FONT></TD><TD ALIGN="LEFT">* <B>zone_id</B></TD><TD ALIGN="LEFT" PORT="zone_id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="price_w"> </TD><TD ALIGN="LEFT">* price</TD><TD ALIGN="LEFT" PORT="price_e"><FONT COLOR="#718096">numeric(10,2)</FONT></TD></TR></TABLE>>];
  events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2b6cb0"><TR><TD COLSPAN="3" BGCOLOR="#ebf4ff"><B>events</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w"><FONT COLOR="#718096">PK</FONT></TD><TD ALIGN="LEFT">* <B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="venue_id_w"><FONT COLOR="#718096">FK</FONT></TD><TD ALIGN="LEFT">* venue_id</TD><TD ALIGN="LEFT" PORT="venue_id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name_w"> </TD><TD ALIGN="LEFT">* name</TD><TD ALIGN="LEFT" PORT="name_e"><FONT COLOR="#718096">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="starts_at_w"> </TD><TD ALIGN="LEFT">* starts_at</TD><TD ALIGN="LEFT" PORT="starts_at_e"><FONT COLOR="#718096">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status_w"> </TD><TD ALIGN="LEFT">* status</TD><TD ALIGN="LEFT" PORT="status_e"><FONT COLOR="#718096">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description_w"> </TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT" PORT="description_e"><FONT COLOR="#718096">text</FONT></TD></TR></TABLE>>];
  orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2b6cb0"><TR><TD COLSPAN="3" BGCOLOR="#ebf4ff"><B>orders</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w"><FONT COLOR="#718096">PK</FONT></TD><TD ALIGN="LEFT">* <B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id_w"><FONT COLOR="#718096">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT" PORT="user_id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at_w"> </TD><TD ALIGN="LEFT">* created_at</TD><TD ALIGN="LEFT" PORT="created_at_e"><FONT COLOR="#718096">timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="contact_phone_w"> </TD><TD ALIGN="LEFT">contact_phone</TD><TD ALIGN="LEFT" PORT="contact_phone_e"><FONT COLOR="#718096">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="contact_email_w"> </TD><TD ALIGN="LEFT">contact_email</TD><TD ALIGN="LEFT" PORT="contact_email_e"><FONT COLOR="#718096">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status_w"> </TD><TD ALIGN="LEFT">* status</TD><TD ALIGN="LEFT" PORT="status_e"><FONT COLOR="#718096">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="promo_code_id_w"><FONT COLOR="#718096">FK</FONT></TD><TD ALIGN="LEFT">promo_code_id</TD><TD ALIGN="LEFT" PORT="promo_code_id_e"><FONT COLOR="#718096">integer</FONT></TD></TR></TABLE>>];
  organizer_members [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2b6cb0"><TR><TD COLSPAN="3" BGCOLOR="#ebf4ff"><B>organizer_members</B></TD></TR><TR><TD ALIGN="LEFT" PORT="organizer_id_w"><FONT COLOR="#718096">PK, FK</FONT></TD><TD ALIGN="LEFT">* <B>organizer_id</B></TD><TD ALIGN="LEFT" PORT="organizer_id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id_w"><FONT COLOR="#718096">PK, FK</FONT></TD><TD ALIGN="LEFT">* <B>user_id</B></TD><TD ALIGN="LEFT" PORT="user_id_e"><FONT COLOR="#718096">integer</FONT></TD></TR></TABLE>>];
  organizers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2b6cb0"><TR><TD COLSPAN="3" BGCOLOR="#ebf4ff"><B>organizers</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w"><FONT COLOR="#718096">PK</FONT></TD><TD ALIGN="LEFT">* <B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name_w"> </TD><TD ALIGN="LEFT">* name</TD><TD ALIGN="LEFT" PORT="name_e"><FONT COLOR="#718096">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="inn_w"><FONT COLOR="#718096">UK</FONT></TD><TD ALIGN="LEFT">* inn</TD><TD ALIGN="LEFT" PORT="inn_e"><FONT COLOR="#718096">varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email_w"> </TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT" PORT="email_e"><FONT COLOR="#718096">varchar(100)</FONT></TD></TR></TABLE>>];
  promo_codes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2b6cb0"><TR><TD COLSPAN="3" BGCOLOR="#ebf4ff"><B>promo_codes</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w"><FONT COLOR="#718096">PK</FONT></TD><TD ALIGN="LEFT">* <B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code_w"><FONT COLOR="#718096">UK</FONT></TD><TD ALIGN="LEFT">* code</TD><TD ALIGN="LEFT" PORT="code_e"><FONT COLOR="#718096">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="discount_type_w"> </TD><TD ALIGN="LEFT">* discount_type</TD><TD ALIGN="LEFT" PORT="discount_type_e"><FONT COLOR="#718096">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="discount_value_w"> </TD><TD ALIGN="LEFT">* discount_value</TD><TD ALIGN="LEFT" PORT="discount_value_e"><FONT COLOR="#718096">numeric(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="valid_from_w"> </TD><TD ALIGN="LEFT">* valid_from</TD><TD ALIGN="LEFT" PORT="valid_from_e"><FONT COLOR="#718096">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="valid_to_w"> </TD><TD ALIGN="LEFT">* valid_to</TD><TD ALIGN="LEFT" PORT="valid_to_e"><FONT COLOR="#718096">date</FONT></TD></TR></TABLE>>];
  seats [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2b6cb0"><TR><TD COLSPAN="3" BGCOLOR="#ebf4ff"><B>seats</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w"><FONT COLOR="#718096">PK</FONT></TD><TD ALIGN="LEFT">* <B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="zone_id_w"><FONT COLOR="#718096">FK</FONT></TD><TD ALIGN="LEFT">* zone_id</TD><TD ALIGN="LEFT" PORT="zone_id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="row_no_w"> </TD><TD ALIGN="LEFT">row_no</TD><TD ALIGN="LEFT" PORT="row_no_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="seat_no_w"> </TD><TD ALIGN="LEFT">* seat_no</TD><TD ALIGN="LEFT" PORT="seat_no_e"><FONT COLOR="#718096">integer</FONT></TD></TR></TABLE>>];
  tickets [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2b6cb0"><TR><TD COLSPAN="3" BGCOLOR="#ebf4ff"><B>tickets</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w"><FONT COLOR="#718096">PK</FONT></TD><TD ALIGN="LEFT">* <B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_id_w"><FONT COLOR="#718096">FK</FONT></TD><TD ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT" PORT="order_id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="event_id_w"><FONT COLOR="#718096">FK</FONT></TD><TD ALIGN="LEFT">* event_id</TD><TD ALIGN="LEFT" PORT="event_id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="zone_id_w"><FONT COLOR="#718096">FK</FONT></TD><TD ALIGN="LEFT">* zone_id</TD><TD ALIGN="LEFT" PORT="zone_id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="holder_first_name_w"> </TD><TD ALIGN="LEFT">* holder_first_name</TD><TD ALIGN="LEFT" PORT="holder_first_name_e"><FONT COLOR="#718096">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="holder_last_name_w"> </TD><TD ALIGN="LEFT">* holder_last_name</TD><TD ALIGN="LEFT" PORT="holder_last_name_e"><FONT COLOR="#718096">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="price_w"> </TD><TD ALIGN="LEFT">* price</TD><TD ALIGN="LEFT" PORT="price_e"><FONT COLOR="#718096">numeric(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status_w"> </TD><TD ALIGN="LEFT">* status</TD><TD ALIGN="LEFT" PORT="status_e"><FONT COLOR="#718096">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="seat_id_w"><FONT COLOR="#718096">FK</FONT></TD><TD ALIGN="LEFT">* seat_id</TD><TD ALIGN="LEFT" PORT="seat_id_e"><FONT COLOR="#718096">integer</FONT></TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2b6cb0"><TR><TD COLSPAN="3" BGCOLOR="#ebf4ff"><B>users</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w"><FONT COLOR="#718096">PK</FONT></TD><TD ALIGN="LEFT">* <B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="first_name_w"> </TD><TD ALIGN="LEFT">* first_name</TD><TD ALIGN="LEFT" PORT="first_name_e"><FONT COLOR="#718096">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_name_w"> </TD><TD ALIGN="LEFT">* last_name</TD><TD ALIGN="LEFT" PORT="last_name_e"><FONT COLOR="#718096">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email_w"><FONT COLOR="#718096">UK</FONT></TD><TD ALIGN="LEFT">* email</TD><TD ALIGN="LEFT" PORT="email_e"><FONT COLOR="#718096">varchar(100)</FONT></TD></TR></TABLE>>];
  venue_zones [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2b6cb0"><TR><TD COLSPAN="3" BGCOLOR="#ebf4ff"><B>venue_zones</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w"><FONT COLOR="#718096">PK</FONT></TD><TD ALIGN="LEFT">* <B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="venue_id_w"><FONT COLOR="#718096">FK</FONT></TD><TD ALIGN="LEFT">* venue_id</TD><TD ALIGN="LEFT" PORT="venue_id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name_w"> </TD><TD ALIGN="LEFT">* name</TD><TD ALIGN="LEFT" PORT="name_e"><FONT COLOR="#718096">varchar(100)</FONT></TD></TR></TABLE>>];
  venues [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2b6cb0"><TR><TD COLSPAN="3" BGCOLOR="#ebf4ff"><B>venues</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w"><FONT COLOR="#718096">PK</FONT></TD><TD ALIGN="LEFT">* <B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#718096">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name_w"> </TD><TD ALIGN="LEFT">* name</TD><TD ALIGN="LEFT" PORT="name_e"><FONT COLOR="#718096">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="city_w"> </TD><TD ALIGN="LEFT">* city</TD><TD ALIGN="LEFT" PORT="city_e"><FONT COLOR="#718096">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="latitude_w"> </TD><TD ALIGN="LEFT">* latitude</TD><TD ALIGN="LEFT" PORT="latitude_e"><FONT COLOR="#718096">numeric(9,6)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="longitude_w"> </TD><TD ALIGN="LEFT">* longitude</TD><TD ALIGN="LEFT" PORT="longitude_e"><FONT COLOR="#718096">numeric(9,6)</FONT></TD></TR></TABLE>>];
  event_artists:artist_id_e:e -> artists:id_w:w [color="#2b6cb0", arrowtail=crowodot, arrowhead=teetee, tooltip="event_artists_artist_id_fkey"];
  event_artists:event_id_e:e -> events:id_w:w [color="#c05621", arrowtail=crowodot, arrowhead=teetee, tooltip="event_artists_event_id_fkey"];
  event_organizers:event_id_e:e -> events:id_w:w [color="#2f855a", arrowtail=crowodot, arrowhead=teetee, tooltip="event_organizers_event_id_fkey"];
  event_organizers:organizer_id_e:e -> organizers:id_w:w [color="#9b2c2c", arrowtail=crowodot, arrowhead=teetee, tooltip="event_organizers_organizer_id_fkey"];
  event_zones:event_id_e:e -> events:id_w:w [color="#6b46c1", arrowtail=crowodot, arrowhead=teetee, tooltip="event_zones_event_id_fkey"];
  event_zones:zone_id_e:e -> venue_zones:id_w:w [color="#b7791f", arrowtail=crowodot, arrowhead=teetee, tooltip="event_zones_zone_id_fkey"];
  events:venue_id_e:e -> venues:id_w:w [color="#2c7a7b", arrowtail=crowodot, arrowhead=teetee, tooltip="events_venue_id_fkey"];
  orders:promo_code_id_e:e -> promo_codes:id_w:w [color="#b83280", arrowtail=crowodot, arrowhead=teeodot, tooltip="orders_promo_code_id_fkey"];
  orders:user_id_e:e -> users:id_w:w [color="#4a5568", arrowtail=crowodot, arrowhead=teeodot, tooltip="orders_user_id_fkey"];
  organizer_members:organizer_id_e:e -> organizers:id_w:w [color="#2b6cb0", arrowtail=crowodot, arrowhead=teetee, tooltip="organizer_members_organizer_id_fkey"];
  organizer_members:user_id_e:e -> users:id_w:w [color="#c05621", arrowtail=crowodot, arrowhead=teetee, tooltip="organizer_members_user_id_fkey"];
  seats:zone_id_e:e -> venue_zones:id_w:w [color="#2f855a", arrowtail=crowodot, arrowhead=teetee, tooltip="seats_zone_id_fkey"];
  tickets:seat_id_e:e -> seats:id_w:w [color="#9b2c2c", arrowtail=crowodot, arrowhead=teetee, tooltip="fk_tickets_seat"];
  tickets:zone_id_e:e -> seats:zone_id_w:w [color="#9b2c2c", arrowtail=crowodot, arrowhead=teetee, tooltip="fk_tickets_seat"];
  tickets:event_id_e:e -> event_zones:event_id_w:w [color="#6b46c1", arrowtail=crowodot, arrowhead=teetee, tooltip="tickets_event_id_zone_id_fkey"];
  tickets:zone_id_e:e -> event_zones:zone_id_w:w [color="#6b46c1", arrowtail=crowodot, arrowhead=teetee, tooltip="tickets_event_id_zone_id_fkey"];
  tickets:order_id_e:e -> orders:id_w:w [color="#b7791f", arrowtail=crowodot, arrowhead=teeodot, tooltip="tickets_order_id_fkey"];
  venue_zones:venue_id_e:e -> venues:id_w:w [color="#2c7a7b", arrowtail=crowodot, arrowhead=teetee, tooltip="venue_zones_venue_id_fkey"];
}
